# Add this block to the Caddyfile of the server (usually /etc/caddy/Caddyfile),
# next to the sites it already serves, then: sudo systemctl reload caddy
#
# Caddy gets the HTTPS certificate by itself. HTTPS is required: the browser
# only signs the OKX demo requests on HTTPS or localhost.
#
# Password: run `caddy hash-password` on the server, type the shared password,
# and paste the hash it prints in place of HASH. The password itself is not
# stored anywhere.

murphyslab.namilabs.ai {
	root * /var/www/murphy-signal-lab
	encode gzip
	file_server

	basic_auth {
		ucema HASH
	}

	# Files under /assets carry a hash in their name, so they can be cached for long.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
